# ---------------------------------------------------------------------------
# Washaholics AI Lead Generation - settings (NO secrets in this file).
# Copy to config.env and edit. API keys / Google logins live ONLY in n8n's
# encrypted credential store, never here.
# ---------------------------------------------------------------------------

# --- Your business ---------------------------------------------------------
COMPANY_NAME="Washaholics"
COMPANY_WEBSITE="https://www.washaholics.co.uk"
SERVICES="exterior commercial cleaning: pressure/jet washing of paving, car parks and forecourts; building facade and cladding cleaning; window cleaning; gutter cleaning; bin store and communal area cleaning; graffiti and chewing-gum removal; signage cleaning"
USP="fully insured, flexible out-of-hours scheduling, one-off or regular contracts, eco-friendly products, free site survey and quote"

# --- Who you are (email signature) ----------------------------------------
SENDER_NAME="Your Name"
SENDER_TITLE="Business Development"
SENDER_PHONE="+44 20 0000 0000"
# Gmail account address the drafts are created in (leave empty to use the account default)
FROM_EMAIL=""
# Where the daily report and error alerts are sent (only to you)
OWNER_EMAIL="you@example.com"

# --- Google Sheet (fill after running "Washaholics 00 - Setup Google Sheet") -
SHEET_ID=""

# --- Volume & quality ------------------------------------------------------
DAILY_MAX=20          # max qualified leads (drafts) per day
DAILY_MIN=10          # target minimum (shown in the report)
CANDIDATE_POOL=40     # how many new businesses are researched & scored per day
MIN_SCORE=60          # Claude relevance score (0-100) needed to qualify
FOLLOWUP_DAYS=4       # days without reply before a follow-up draft is prepared
EXCLUDE_DOMAINS="hilton.com,marriott.com,ihg.com,accor.com,premierinn.com,travelodge.co.uk,mcdonalds.com,nandos.co.uk,pizzaexpress.com,wagamama.com,starbucks.co.uk"

# --- AI --------------------------------------------------------------------
# "true"  = Claude scores leads and writes tailored emails (needs the Anthropic credential)
# "false" = no API: rule-based scoring, template emails, keyword reply sorting (free)
AI_ENABLED="true"
AI_MODEL="claude-opus-5-5"
AI_EFFORT="medium"

# --- Schedules (cron, in TIMEZONE) ------------------------------------------
TIMEZONE="Europe/London"
LEADGEN_CRON="0 8 * * *"
REPLY_CRON="15 8-20/2 * * *"
REPORT_CRON="0 18 * * *"

# --- n8n credential names (only change if you named them differently) -------
# CRED_SHEETS="Washaholics - Google Sheets"
# CRED_GMAIL="Washaholics - Gmail"
# CRED_PLACES="Washaholics - Google Places API Key"
# CRED_ANTHROPIC="Washaholics - Anthropic API Key"
